# Work-environment terminal tools selected by MISE_ENV when needed.
tap "derailed/k9s", trusted: true
brew "actionlint"
brew "derailed/k9s/k9s"
brew "libpq"
brew "postgresql"
brew "sqlfluff"
brew "zizmor"

# coursier for scala
brew "coursier/formulas/coursier", trusted: true

# MS
tap "azure/bicep", trusted: true
brew "azure-cli"
brew "bicep"
brew "go-task/tap/go-task", trusted: true
cask "git-credential-manager"
brew "powershell"

# docker
brew "docker"
brew "docker-compose"
brew "docker-credential-helper"
